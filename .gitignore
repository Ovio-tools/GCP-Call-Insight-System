# Dependencies
node_modules/

# Build output
dist/
coverage/

# Environment / secrets — never commit real config
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
*.tsbuildinfo

# Vendored NER model weights (fetched by npm run model:fetch). No trailing slash so a local
# `models` SYMLINK (common in worktrees) is ignored too, not just a real directory.
models

# Real reviewed-fixture exports (Task 6.3) — never commit real redacted transcripts. Only the
# synthetic samples under test/fixtures/**/reviewed/ are committed; `npm run eval:export` writes
# real projections here.
var/evaluation/
