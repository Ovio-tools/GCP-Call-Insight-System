# Secret scanning before every commit (build plan §3).
# Requires the gitleaks binary on PATH: `brew install gitleaks`.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found. Install it (e.g. 'brew install gitleaks') to commit." >&2
  exit 1
fi

gitleaks git --staged --redact --no-banner --config .gitleaks.toml
