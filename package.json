{
  "name": "gcp-call-insights",
  "version": "0.0.0",
  "private": true,
  "description": "Call-processing pipeline (scaffolding only).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "db:migrate": "node dist/scripts/migrate.js up",
    "db:migrate:down": "node dist/scripts/migrate.js down",
    "prepare": "husky"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.9"
  }
}
