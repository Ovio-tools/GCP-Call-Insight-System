{
  "name": "gcp-call-insights",
  "version": "0.0.0",
  "private": true,
  "description": "Call-processing pipeline (scaffolding only).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:security": "vitest run test/security",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "db:migrate": "node dist/scripts/migrate.js up",
    "db:migrate:down": "node dist/scripts/migrate.js down",
    "requeue:classify": "node dist/scripts/requeue-parked-classify.js",
    "requeue:extract": "node dist/scripts/requeue-parked-extract.js",
    "record-consent": "node dist/scripts/record-consent.js",
    "notes:generate": "node dist/scripts/generate-technician-notes.js",
    "eval:sync": "node dist/scripts/sync-labeled-examples.js",
    "eval:export": "node dist/scripts/export-reviewed-fixtures.js",
    "eval:run": "node dist/scripts/run-evaluation.js",
    "key:bootstrap": "node dist/scripts/bootstrap-key.js",
    "key:rotate-kek": "node dist/scripts/rotate-kek.js",
    "key:rotate": "node dist/scripts/rotate-key.js",
    "key:revoke": "node dist/scripts/revoke-key.js",
    "key:confirm-destruction": "node dist/scripts/confirm-destruction.js",
    "prepare": "husky",
    "model:fetch": "node dist/scripts/fetch-ner-model.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/session": "^11.1.1",
    "@huggingface/transformers": "4.2.0",
    "bullmq": "^5.79.2",
    "fastify": "^5.9.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.11.1",
    "node-pg-migrate": "^8.0.4",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "ioredis": "$ioredis",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
