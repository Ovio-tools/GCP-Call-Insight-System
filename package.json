{
  "name": "gcp-call-insights",
  "version": "0.0.0",
  "private": true,
  "description": "Call-processing pipeline (scaffolding only).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "db:migrate": "node dist/scripts/migrate.js up",
    "db:migrate:down": "node dist/scripts/migrate.js down",
    "requeue:classify": "node dist/scripts/requeue-parked-classify.js",
    "prepare": "husky",
    "model:fetch": "node dist/scripts/fetch-ner-model.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/session": "^11.1.1",
    "@huggingface/transformers": "4.2.0",
    "bullmq": "^5.79.2",
    "fastify": "^5.9.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.11.1",
    "node-pg-migrate": "^8.0.4",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "ioredis": "$ioredis"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.9"
  }
}
