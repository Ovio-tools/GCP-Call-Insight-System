# Configuration for gcp-call-insights.
#
# 12-factor: all configuration comes from environment variables. This file mirrors
# src/config/schema.ts EXACTLY — when you change the schema, change this file in the
# same commit. Never put real secrets here; use placeholder values only.

# --- Required ---

# Deployment environment: development | test | staging | production
NODE_ENV=development

# --- Required in every real deployment (validated by the readiness check, not the
#     config loader — a missing/unreachable store exits DATABASE_UNAVAILABLE /
#     REDIS_UNAVAILABLE, not CONFIG_MISSING_OR_INVALID) ---

# Postgres connection string (primary relational store).
DATABASE_URL=postgres://user:password@localhost:5432/gcp_call_insights

# Redis connection string (BullMQ queue backend).
REDIS_URL=redis://localhost:6379

# --- Optional (defaults shown) ---

# Readiness connect timeouts (ms) — fail fast rather than hang.
DB_CONNECT_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Service name attached to every log line.
SERVICE_NAME=gcp-call-insights

# HTTP port for internal surfaces.
PORT=8080

# --- Envelope encryption (raw_transcripts, token_vault) ---

# Key source: local | keystore | kms. `local` derives DEKs from CRYPTO_LOCAL_MASTER_KEY and is
# refused in staging/production. `keystore` is the DB-sourced external KeyStore (Task 8.2,
# dev/staging via LocalFileKeyStore; refused in production pending Task 8.2b). `kms` (production
# external key service) is Task 8.2b — still throws.
CRYPTO_KEY_PROVIDER=local

# Base64-encoded master secret for the local provider (must decode to >= 32 bytes).
# PLACEHOLDER ONLY — generate a real per-environment secret with
# `openssl rand -base64 32` and set it via the environment, never commit it.
CRYPTO_LOCAL_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_SECRET

# key_version that new encrypted rows are written under (LOCAL provider only; the keystore
# provider is DB-sourced via the single active key_versions row).
CRYPTO_ACTIVE_KEY_VERSION=1

# --- External key store (Task 8.2, `keystore` provider) ---
# Directory that IS the external secret store for LocalFileKeyStore (KEK bytes + wrapped DEK
# files). Dev/staging only. Required when CRYPTO_KEY_PROVIDER=keystore.
CRYPTO_KEY_STORE_DIR=./.keystore
# Bootstrap/seed KEK version for `bootstrap-key` (the live active KEK is DB-sourced thereafter).
CRYPTO_KEK_VERSION=kek-1
# Mandatory recovery window (days, >= 0) before destroyed key material is truly purged. 0 =
# immediate (dev); staging should use a nonzero window.
KEY_STORE_RECOVERY_WINDOW_DAYS=0
# Kill switch for the DESTRUCTIVE key CLIs (rotate-key/revoke-key). NOT the approval — each run
# still requires --actor/--approval-ref and a typed confirmation phrase.
CRYPTO_KEY_DESTROY_COMMANDS_ENABLED=false
# Max time (ms) rotation waits for in-flight jobs to drain after pausing the queue before it
# aborts safely (releases locks, resumes the queue, emits KEY_ROTATION_FAILED).
KEY_ROTATION_DRAIN_TIMEOUT_MS=300000
# Delay (ms) the processor backstop re-delays an already-fetched job by during a rotation pause
# (moveToDelayed + DelayedError — never consumes a retry).
KEY_ROTATION_MAINTENANCE_REQUEUE_DELAY_MS=5000
# Time (ms) rotation stays paused AFTER the destroy-request so every worker's active-version cache
# expires before the queue resumes (no stale-cache write under the doomed key). MUST be >= the
# active-version cache TTL across all encrypting services (default 5s). 0 disables (single-node).
KEY_ROTATION_ACTIVE_VERSION_SETTLE_MS=6000

# Real KMS settings (KMS_KEY_ID, etc.) are added in Task 8.2.

# --- Worker / BullMQ pipeline (Task 2.1) ---

# BullMQ queue name for the per-call pipeline.
WORKER_QUEUE_NAME=call-pipeline

# How many calls the pipeline worker processes concurrently.
WORKER_CONCURRENCY=5

# Capped retry count per job (BullMQ attempts; includes the first attempt).
WORKER_MAX_ATTEMPTS=5

# Base delay (ms) for exponential backoff between retries.
WORKER_BACKOFF_MS=1000

# Kill switch: true | false. When true the worker boots but does not consume;
# queued jobs stay untouched in Redis until it is turned off and redeployed.
WORKER_KILL_SWITCH=false

# --- Alerting / failure model (Task 2.2) ---

# Minutes an unacknowledged critical alert may sit before it escalates.
ALERT_ESCALATION_WINDOW_MINUTES=15

# --- Shared HTTP hardening & auth middleware (Task 2.3) ---

# Max accepted request body size in bytes. Larger bodies are rejected (413) before parsing.
HTTP_MAX_BODY_BYTES=1048576

# Comma-separated CORS origin allowlist. Empty = deny all cross-origin (the default).
CORS_ALLOWED_ORIGINS=

# Trusted reverse-proxy hop count for the real client IP (Railway = 1). Never set this so
# high that clients can spoof X-Forwarded-For. 0 disables proxy trust.
TRUSTED_PROXY_HOPS=1

# Tier-1 per-IP rate limit: coarse guard for all traffic from one address (many users may
# share a NAT), so keep it generous. Max requests per window (ms).
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# Tier-2 per-authenticated-user rate limit: per-identity fairness, applied after auth.
# Keep below the IP tier so one user cannot exhaust the shared IP budget.
USER_RATE_LIMIT_MAX=120
USER_RATE_LIMIT_WINDOW_MS=60000

# Webhook rate limit (per provider/IP): higher/burstier than the internal tier.
WEBHOOK_RATE_LIMIT_MAX=600
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Replay-protection window (ms): how long a seen provider:eventId is remembered.
WEBHOOK_REPLAY_WINDOW_MS=300000

# Max allowed webhook timestamp skew (ms), either direction. Stale/future beyond this = 400.
WEBHOOK_TIMESTAMP_SKEW_MS=300000

# Secret that signs the session cookie (>= 32 chars). PLACEHOLDER ONLY — generate a real
# per-environment secret with `openssl rand -base64 32` and set it via the environment.
SESSION_SECRET=REPLACE_WITH_32_PLUS_CHAR_SESSION_SECRET

# Session cookie name.
SESSION_COOKIE_NAME=sid

# Server-side session lifetime in ms (default 8h).
SESSION_TTL_MS=28800000

# Session cookie Secure flag: true | false. Only `false` in dev/test over plain HTTP;
# the auth plugin refuses `false` in staging/production.
SESSION_COOKIE_SECURE=true

# --- OIDC auth provider (Task 2.3) ---
# All optional at boot; the OIDC adapter validates presence when it is actually built.
# Works with any OIDC issuer (Google Workspace, Auth0, Okta, WorkOS, ...).
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_SCOPES=openid profile email

# --- Dialpad webhook receiver (Task 3.2) ---
# Shared secret Dialpad signs each webhook JWT with (HS256, >= 16 chars). REQUIRED wherever
# the Dialpad route is registered. PLACEHOLDER ONLY — generate a real per-environment secret
# (e.g. `openssl rand -base64 32`) and set the same value in the Dialpad event subscription.
DIALPAD_WEBHOOK_SECRET=REPLACE_WITH_DIALPAD_WEBHOOK_SECRET
# Previous signing secret, accepted alongside the primary during a rotation overlap only.
# Leave unset except while rotating (see docs/dialpad-webhook.md).
DIALPAD_WEBHOOK_SECRET_PREVIOUS=
# Secret keying the one-way HMAC that hashes any phone/name before it is stored (>= 16 chars).
# REQUIRED wherever the Dialpad route is registered. PLACEHOLDER ONLY.
DIALPAD_PII_HASH_SECRET=REPLACE_WITH_DIALPAD_PII_HASH_SECRET
# Retention window (ms) applied by the retention cron (Task 8.1) to audit rows. Default 7 days.
RAW_WEBHOOK_RETENTION_MS=604800000

# --- Dialpad transcript client (Task 3.3) ---

# Dialpad API base URL (v2).
DIALPAD_BASE_URL=https://dialpad.com/api/v2

# Dialpad API key, sent as `Authorization: Bearer <key>` (an OAuth access token works too).
# Optional at boot, but the worker / reconciliation cron fail fast with
# CONFIG_MISSING_OR_INVALID naming DIALPAD_API_KEY if it is absent. PLACEHOLDER ONLY —
# set a real per-environment key via the environment, never commit it.
DIALPAD_API_KEY=REPLACE_WITH_DIALPAD_API_KEY

# Per-request timeout (ms) for a Dialpad HTTP call.
DIALPAD_API_TIMEOUT_MS=10000

# Retries AFTER the first attempt for 429/5xx/timeout (total HTTP calls = 1 + this).
DIALPAD_API_MAX_RETRIES=4

# Base delay (ms) for exponential backoff + jitter between client retries.
DIALPAD_API_BACKOFF_MS=500

# Transcript-endpoint rate limit (requests/minute) and company-wide limit (requests/second).
# The shared Redis limiter enforces the tighter of the two.
DIALPAD_RATE_PER_MINUTE=1200
DIALPAD_RATE_PER_SECOND=20

# How long (ms) to wait for a not-yet-ready transcript before holding the call with
# missing_transcript (default 30 min), and the delay (ms) between not-ready retries.
DIALPAD_TRANSCRIPT_WAIT_MAX_MS=1800000
DIALPAD_TRANSCRIPT_POLL_MS=60000

# --- Reconciliation cron (Task 3.4) ---

# Lookback window (minutes) for the reconciliation sweep. Longer than the 15-minute cron
# cadence on purpose: consecutive runs overlap, so a delayed or missed run still catches
# every concluded call (the enqueue is idempotent, so overlap is harmless).
RECONCILIATION_WINDOW_MINUTES=45

# Longest plausible call (minutes). Dialpad's list API only filters by START time, so the
# sweep reaches back window + this margin to catch long calls that concluded in-window.
RECONCILIATION_MAX_CALL_MINUTES=180

# The reconciliation cron's OWN dead-man's-switch URL (e.g. a Healthchecks.io ping URL),
# pinged only after a fully successful sweep. Leave unset locally to skip the ping.
RECONCILIATION_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_RECONCILIATION_CHECK_ID

# --- Historical backfill runner (Task 11.2) ---

# The backfill runner's OWN job-style dead-man's-switch base URL. The runner derives FOUR
# distinct signal URLs from it: start=${base}/start, progress=${base}/progress,
# success=${base}, fail=${base}/fail. Leave unset locally to skip the ping; the runner REQUIRES
# it in staging & production. A pairwise collision after derivation fails at construction.
BACKFILL_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_BACKFILL_CHECK_ID

# Longest plausible call (minutes) for the backfill list query. Like RECONCILIATION_MAX_CALL_MINUTES,
# the scan reaches back from - this margin (Dialpad lists by START time only).
BACKFILL_MAX_CALL_MINUTES=240

# Job-monitor progress cadence + stall threshold (ms). While within the stall threshold the
# monitor sends a progress ping every interval; past it, it withholds so the external monitor's
# missing-progress window fires the stall alert. STALL is generous (transcript availability).
BACKFILL_PROGRESS_INTERVAL_MS=60000
BACKFILL_STALL_THRESHOLD_MS=21600000

# Delay (ms) between drain-phase polls that check whether every tracked call reached a terminal
# state before the terminal success ping.
BACKFILL_DRAIN_POLL_MS=15000

# --- Per-component dead-man's switches (Task 7.1) ---

# Each long-running component pings its OWN external monitor URL, provider-neutral (any
# service exposing a per-check ping URL works — Healthchecks.io, Better Uptime, ...). A
# shared URL is forbidden: it would stay green while one cron is dead. Leave unset locally to
# skip the ping; the worker and crons REQUIRE their own URL in staging & production or boot
# fails with CONFIG_MISSING_OR_INVALID naming the missing variable.
# (RECONCILIATION_CHECK_URL is the reconciliation cron's own check, in the section above.)
WORKER_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_WORKER_CHECK_ID
RETENTION_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_RETENTION_CHECK_ID
# The evaluation cron's own check (Task 6.3), pinged only after a COMPLETE live accuracy run.
EVALUATION_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_EVALUATION_CHECK_ID

# How often (ms) the worker pings its liveness check while healthy. Keep it shorter than the
# external monitor's grace period so a single missed beat does not false-alarm.
WORKER_HEARTBEAT_INTERVAL_MS=60000

# Per-request timeout (ms) for the heartbeat HTTP GET. Fail fast rather than hang a beat.
HEARTBEAT_PING_TIMEOUT_MS=5000

# --- Classify stage / model spend (Task 5.1) ---

# Anthropic API key. Optional at boot, like DIALPAD_API_KEY — the Anthropic client
# construction validates presence, not boot. PLACEHOLDER ONLY — set a real per-environment
# key via the environment, never commit it.
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# Model ID for the classify stage. Never hardcoded outside config.
CLASSIFY_MODEL_ID=claude-haiku-4-5-20251001

# Kill switch: true | false. While false, the classify stage makes no Anthropic calls.
CLASSIFY_ENABLED=false

# Max output tokens requested per classify call.
CLASSIFY_MAX_TOKENS=512

# Cost-reservation floor (input tokens): the classify handler reserves against
# max(this ceiling, payload byte-estimate).
CLASSIFY_INPUT_TOKENS_CEILING=30000

# Fixed structured-output/request-scaffolding overhead (tokens) added to the byte-bound
# payload estimate when reserving against the daily cost cap.
CLASSIFY_RESERVATION_OVERHEAD_TOKENS=1000

# Anthropic TS SDK request timeout (ms).
ANTHROPIC_TIMEOUT_MS=30000

# Daily hard cap (USD) on model spend, enforced across ALL model stages.
DAILY_MODEL_COST_CAP_USD=25

# Fraction of DAILY_MODEL_COST_CAP_USD at which an advisory warning alert
# (MODEL_COST_WARNING_THRESHOLD_EXCEEDED) is emitted — at most once per UTC day, never blocking
# the pipeline (Task 7.2). A strict fraction in (0, 1).
DAILY_MODEL_COST_WARNING_THRESHOLD_RATIO=0.8

# Haiku 4.5 list price per million input/output tokens (USD). Classify-scoped on purpose —
# Task 5.2 adds its own EXTRACT_* rates for Sonnet; the shared cost helper takes explicit
# rates with no defaults so a different model can never silently inherit Haiku pricing.
CLASSIFY_COST_USD_PER_MTOK_INPUT=1
CLASSIFY_COST_USD_PER_MTOK_OUTPUT=5

# --- Redaction stage (Task 4.1) ---

# Risk score at or above which a call is held with redaction_failed. Forced-hold
# reasons (offset alignment failure, residual scan hit) hold regardless of this value.
REDACTION_RISK_THRESHOLD=0.7

# Labeled-corpus recall the CI gate enforces (fails as REDACTION_RECALL_REGRESSION below it).
REDACTION_RECALL_TARGET=0.95

# Optional path to a newline-delimited client deny-list file (terms that must never pass).
# The file lives OUTSIDE the repo. Absent => empty deny list.
# REDACTION_DENY_LIST_PATH=/etc/call-insights/deny-list.txt

# transformers.js NER model id and the local directory it is vendored into by
# `npm run model:fetch`. Runtime is fully offline (allowRemoteModels=false).
REDACTION_NER_MODEL_ID=Xenova/bert-base-NER
REDACTION_NER_MODEL_DIR=models

# NER spans below this confidence are DROPPED (not redacted) and raise the
# ner_low_confidence risk reason — the ADR 0006 precision gate. 0.7 keeps >= 0.05
# margin under the weakest corpus-needed name span (0.7614, measured 2026-07).
REDACTION_NER_MIN_SCORE=0.7

# CSV of NER entity scopes actually redacted (ADR 0006). person = PER spans;
# numbered_location = LOC spans only when a house-style number is directly adjacent
# (suffix-less addresses); location/organization/misc opt back in to bare cities /
# business names / MISC. The regex layer always covers structured PII regardless.
REDACTION_NER_ENTITY_SCOPE=person,numbered_location

# Long-transcript chunking: chunk size and overlap (chars). Overlap keeps entities that
# span a chunk boundary visible whole in at least one chunk.
REDACTION_NER_CHUNK_CHARS=1500
REDACTION_NER_CHUNK_OVERLAP_CHARS=250

# Base64 key (>= 32 bytes decoded) for the per-call HMAC over normalized detected values
# in redaction_findings.value_hash. Optional at boot; the worker and the redaction handler
# fail fast with CONFIG_MISSING_OR_INVALID naming this variable if absent. PLACEHOLDER
# ONLY — set a real per-environment key via the environment, never commit it.
REDACTION_VALUE_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Extract stage / model spend (Task 5.2) ---

# Model ID for the extract stage. Never hardcoded outside config.
EXTRACT_MODEL_ID=claude-sonnet-4-6

# Kill switch: true | false. While false, the extract stage makes no Anthropic calls. The
# 4.1/5.1 chain is not yet live end-to-end; recovery via requeue-parked-extract after
# enabling.
EXTRACT_ENABLED=false

# Max output tokens requested per extract call.
EXTRACT_MAX_TOKENS=4096

# Cost-reservation floor (input tokens): the extract handler reserves against
# max(this ceiling, payload byte-estimate).
EXTRACT_INPUT_TOKENS_CEILING=30000

# Fixed structured-output/request-scaffolding overhead (tokens) added to the byte-bound
# payload estimate when reserving against the daily cost cap.
EXTRACT_RESERVATION_OVERHEAD_TOKENS=1000

# Sonnet list price per million input/output tokens (USD). Extract-scoped on purpose — the
# shared cost helper takes explicit rates with no defaults so a different model can never
# silently inherit the wrong pricing.
EXTRACT_COST_USD_PER_MTOK_INPUT=3
EXTRACT_COST_USD_PER_MTOK_OUTPUT=15

# --- Status surface + alert delivery (Task 7.3) ---

# Auto-refresh cadence (seconds) for the server-rendered /status page (0 disables auto-refresh;
# a manual refresh link is always present). Load/refresh only — no streaming or per-call animation.
STATUS_PAGE_REFRESH_SECONDS=30

# Staleness thresholds (ms) for the in-DB component heartbeat mirror: a periodic-liveness
# component (worker + crons) whose last_run_at is older than its threshold renders `broken`.
# The webhook receiver is liveness-vs-activity split and never goes `broken` from idleness.
# Sized per cadence; defaults leave slack for one missed tick (worker minutes, reconciliation
# ~15 min, retention daily ~26h).
WORKER_HEARTBEAT_STALE_MS=180000
RECONCILIATION_HEARTBEAT_STALE_MS=2700000
RETENTION_HEARTBEAT_STALE_MS=93600000

# Outbound Slack-compatible alert webhook ({text} POST). Optional locally — delivery no-ops
# (rows stay pending, the retry sweep re-attempts) when unset. REQUIRED in staging/production
# (the alerting entrypoint fails fast with CONFIG_MISSING_OR_INVALID) so critical alerts are
# never silently undeliverable. PLACEHOLDER ONLY — never commit a real webhook URL.
ALERT_WEBHOOK_URL=https://hooks.example.com/services/REPLACE_WITH_ALERT_WEBHOOK
ALERT_WEBHOOK_TIMEOUT_MS=5000

# Max delivery attempts per alert row before the retry sweep stops (row stays `failed`,
# visible for manual follow-up). Includes the immediate attempt.
ALERT_DELIVERY_MAX_ATTEMPTS=6

# Base delay (ms) for the alert-delivery exponential backoff between retries.
ALERT_DELIVERY_BACKOFF_MS=60000

# --- Review queue / held-call retention (Task 6.1) ---

# Per-held_reason review SLA (minutes) as a JSON object. REQUIRED — no default (fail-closed:
# the pipeline must not run without an explicit SLA policy). MUST be exhaustive over every
# held_reason, `emergency_review` MUST be the strict minimum, and every value MUST be >= the
# reconciliation-cron scan cadence (15 min) so no SLA is shorter than the breach-detection
# interval. Malformed JSON / a missing reason / a too-short value all fail boot with
# CONFIG_MISSING_OR_INVALID naming the variable.
REVIEW_SLA_MINUTES_BY_REASON={"emergency_review":15,"redaction_failed":60,"residual_pii_detected":60,"classifier_uncertain":120,"malformed_model_output":120,"schema_invalid":120,"missing_transcript":240,"cost_cap_held":240,"weak_servicetitan_match":480,"classified_spam":1440}

# Max age (hours) an unresolved held call's raw transcript + token vault may be retained
# before the retention cron (Task 8.1) purges them, regardless of review status. REQUIRED —
# no default (a raw-PII retention cap must be an explicit decision).
REVIEW_HELD_RAW_RETENTION_CAP_HOURS=72

# --- Scheduled retention / purge windows (Task 8.1) ---
#
# Soft- then hard-delete windows in DAYS for the five purge groups. REQUIRED — no default
# (privacy policy: a purge window must be an explicit decision). Per group HARD must be >
# SOFT, guaranteeing a real recoverable grace gap: a row is soft-deleted on one run and can
# only be hard-deleted (stamp-and-scrub) on a later run after the grace elapses.
RETENTION_RAW_SOFT_DELETE_DAYS=7
RETENTION_RAW_HARD_DELETE_DAYS=30
RETENTION_WEBHOOK_SOFT_DELETE_DAYS=7
RETENTION_WEBHOOK_HARD_DELETE_DAYS=30
RETENTION_MATCH_KEYS_SOFT_DELETE_DAYS=7
RETENTION_MATCH_KEYS_HARD_DELETE_DAYS=30
RETENTION_EXTRACT_SOFT_DELETE_DAYS=30
RETENTION_EXTRACT_HARD_DELETE_DAYS=90
# CLEAN group (clean_transcripts + redaction_findings) is a WHOLE two-mode value: either both
# sides numeric (windowed, HARD > SOFT) OR both `never` (indefinite — kept active until
# review-driven resolution; neither soft_deleted_at nor hard_deleted_at is ever set). A mixed
# pair (one `never`, one numeric) fails boot with CONFIG_MISSING_OR_INVALID.
#   Indefinite mode: RETENTION_CLEAN_SOFT_DELETE_DAYS=never / RETENTION_CLEAN_HARD_DELETE_DAYS=never
RETENTION_CLEAN_SOFT_DELETE_DAYS=30
RETENTION_CLEAN_HARD_DELETE_DAYS=365

# Dry-run: when true, the purge counts eligible rows/groups and writes nothing. Default false.
RETENTION_DRY_RUN=false
# Rows deleted per batched pass; the purge loops until a pass touches 0 rows. Default 1000.
RETENTION_PURGE_BATCH_SIZE=1000

# --- Review & admin surface (Task 6.2) ---

# Role name (matched against the session's roles) required for an elevated raw/vault reveal on
# the review surface. Optional and fail-closed: when unset, NO session is elevated and every
# reveal is refused (AUTH_FORBIDDEN). Any authenticated session is still a base reviewer (list,
# detail, and the seven actions). Not a secret.
REVIEW_ELEVATED_ROLE=review_elevated

# --- Evaluation runner / labeled-examples corpus (Task 6.3) ---

# Kill switch for the weekly accuracy check (eval:run / the evaluation cron). Default false.
# Label-sync (the reconciliation-cron duty) runs regardless — capture must beat the CLEAN purge
# window. Explicit 'true'/'false', never truthy-coerced.
EVALUATION_RUN_ENABLED=false
# When true the accuracy check calls the real models (records model_invocations + honors the cost
# cap / kill switch). In staging/production, EVALUATION_RUN_ENABLED=true + this false is a fail-fast
# CONFIG_MISSING_OR_INVALID — the check must never write a non-live stub report or ping green
# without calling the models. The stub path is test/local-only (the --stub flag).
EVALUATION_LIVE_MODE=false
# (EVALUATION_CHECK_URL is the evaluation cron's own check, in the heartbeats section above.)

# --- Knowledge-base surface (Task 10.1) ---

# The authenticated read-only knowledge surface over structured_knowledge. The VIEW is paginated;
# the EXPORT returns all rows matching the filters up to KNOWLEDGE_MAX_EXPORT_ROWS.
# Default page size for the view when page_size is omitted; clamped to [1, KNOWLEDGE_PAGE_SIZE_MAX].
# Boot fails (CONFIG_MISSING_OR_INVALID) if DEFAULT > MAX.
KNOWLEDGE_PAGE_SIZE_DEFAULT=50
# Upper bound for the view page_size (a larger request is clamped to it).
KNOWLEDGE_PAGE_SIZE_MAX=200
# Hard cap on rows an export returns; truncation is signalled by CSV X-Export-* headers / JSON truncated.
KNOWLEDGE_MAX_EXPORT_ROWS=5000
