# Configuration for gcp-call-insights.
#
# 12-factor: all configuration comes from environment variables. This file mirrors
# src/config/schema.ts EXACTLY — when you change the schema, change this file in the
# same commit. Never put real secrets here; use placeholder values only.

# --- Required ---

# Deployment environment: development | test | staging | production
NODE_ENV=development

# --- Required in every real deployment (validated by the readiness check, not the
#     config loader — a missing/unreachable store exits DATABASE_UNAVAILABLE /
#     REDIS_UNAVAILABLE, not CONFIG_MISSING_OR_INVALID) ---

# Postgres connection string (primary relational store).
DATABASE_URL=postgres://user:password@localhost:5432/gcp_call_insights

# Redis connection string (BullMQ queue backend).
REDIS_URL=redis://localhost:6379

# --- Optional (defaults shown) ---

# Readiness connect timeouts (ms) — fail fast rather than hang.
DB_CONNECT_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=5000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Service name attached to every log line.
SERVICE_NAME=gcp-call-insights

# HTTP port for internal surfaces.
PORT=8080

# --- Envelope encryption (raw_transcripts, token_vault) ---

# Key source: local | kms. `local` derives DEKs from CRYPTO_LOCAL_MASTER_KEY and is
# refused in staging/production. `kms` (external key service) is Task 8.2.
CRYPTO_KEY_PROVIDER=local

# Base64-encoded master secret for the local provider (must decode to >= 32 bytes).
# PLACEHOLDER ONLY — generate a real per-environment secret with
# `openssl rand -base64 32` and set it via the environment, never commit it.
CRYPTO_LOCAL_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_SECRET

# key_version that new encrypted rows are written under.
CRYPTO_ACTIVE_KEY_VERSION=1

# Real KMS settings (KMS_KEY_ID, etc.) are added in Task 8.2.

# --- Worker / BullMQ pipeline (Task 2.1) ---

# BullMQ queue name for the per-call pipeline.
WORKER_QUEUE_NAME=call-pipeline

# How many calls the pipeline worker processes concurrently.
WORKER_CONCURRENCY=5

# Capped retry count per job (BullMQ attempts; includes the first attempt).
WORKER_MAX_ATTEMPTS=5

# Base delay (ms) for exponential backoff between retries.
WORKER_BACKOFF_MS=1000

# Kill switch: true | false. When true the worker boots but does not consume;
# queued jobs stay untouched in Redis until it is turned off and redeployed.
WORKER_KILL_SWITCH=false

# --- Alerting / failure model (Task 2.2) ---

# Minutes an unacknowledged critical alert may sit before it escalates.
ALERT_ESCALATION_WINDOW_MINUTES=15

# --- Shared HTTP hardening & auth middleware (Task 2.3) ---

# Max accepted request body size in bytes. Larger bodies are rejected (413) before parsing.
HTTP_MAX_BODY_BYTES=1048576

# Comma-separated CORS origin allowlist. Empty = deny all cross-origin (the default).
CORS_ALLOWED_ORIGINS=

# Trusted reverse-proxy hop count for the real client IP (Railway = 1). Never set this so
# high that clients can spoof X-Forwarded-For. 0 disables proxy trust.
TRUSTED_PROXY_HOPS=1

# Tier-1 per-IP rate limit: coarse guard for all traffic from one address (many users may
# share a NAT), so keep it generous. Max requests per window (ms).
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# Tier-2 per-authenticated-user rate limit: per-identity fairness, applied after auth.
# Keep below the IP tier so one user cannot exhaust the shared IP budget.
USER_RATE_LIMIT_MAX=120
USER_RATE_LIMIT_WINDOW_MS=60000

# Webhook rate limit (per provider/IP): higher/burstier than the internal tier.
WEBHOOK_RATE_LIMIT_MAX=600
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Replay-protection window (ms): how long a seen provider:eventId is remembered.
WEBHOOK_REPLAY_WINDOW_MS=300000

# Max allowed webhook timestamp skew (ms), either direction. Stale/future beyond this = 400.
WEBHOOK_TIMESTAMP_SKEW_MS=300000

# Secret that signs the session cookie (>= 32 chars). PLACEHOLDER ONLY — generate a real
# per-environment secret with `openssl rand -base64 32` and set it via the environment.
SESSION_SECRET=REPLACE_WITH_32_PLUS_CHAR_SESSION_SECRET

# Session cookie name.
SESSION_COOKIE_NAME=sid

# Server-side session lifetime in ms (default 8h).
SESSION_TTL_MS=28800000

# Session cookie Secure flag: true | false. Only `false` in dev/test over plain HTTP;
# the auth plugin refuses `false` in staging/production.
SESSION_COOKIE_SECURE=true

# --- OIDC auth provider (Task 2.3) ---
# All optional at boot; the OIDC adapter validates presence when it is actually built.
# Works with any OIDC issuer (Google Workspace, Auth0, Okta, WorkOS, ...).
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_SCOPES=openid profile email

# --- Dialpad transcript client (Task 3.3) ---

# Dialpad API base URL (v2).
DIALPAD_BASE_URL=https://dialpad.com/api/v2

# Dialpad API key, sent as `Authorization: Bearer <key>` (an OAuth access token works too).
# Optional at boot, but the worker / reconciliation cron fail fast with
# CONFIG_MISSING_OR_INVALID naming DIALPAD_API_KEY if it is absent. PLACEHOLDER ONLY —
# set a real per-environment key via the environment, never commit it.
DIALPAD_API_KEY=REPLACE_WITH_DIALPAD_API_KEY

# Per-request timeout (ms) for a Dialpad HTTP call.
DIALPAD_API_TIMEOUT_MS=10000

# Retries AFTER the first attempt for 429/5xx/timeout (total HTTP calls = 1 + this).
DIALPAD_API_MAX_RETRIES=4

# Base delay (ms) for exponential backoff + jitter between client retries.
DIALPAD_API_BACKOFF_MS=500

# Transcript-endpoint rate limit (requests/minute) and company-wide limit (requests/second).
# The shared Redis limiter enforces the tighter of the two.
DIALPAD_RATE_PER_MINUTE=1200
DIALPAD_RATE_PER_SECOND=20

# How long (ms) to wait for a not-yet-ready transcript before holding the call with
# missing_transcript (default 30 min), and the delay (ms) between not-ready retries.
DIALPAD_TRANSCRIPT_WAIT_MAX_MS=1800000
DIALPAD_TRANSCRIPT_POLL_MS=60000

# --- Reconciliation cron (Task 3.4) ---

# Lookback window (minutes) for the reconciliation sweep. Longer than the 15-minute cron
# cadence on purpose: consecutive runs overlap, so a delayed or missed run still catches
# every concluded call (the enqueue is idempotent, so overlap is harmless).
RECONCILIATION_WINDOW_MINUTES=45

# Longest plausible call (minutes). Dialpad's list API only filters by START time, so the
# sweep reaches back window + this margin to catch long calls that concluded in-window.
RECONCILIATION_MAX_CALL_MINUTES=180

# The reconciliation cron's OWN dead-man's-switch URL (e.g. a Healthchecks.io ping URL),
# pinged only after a fully successful sweep. Leave unset locally to skip the ping.
RECONCILIATION_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_RECONCILIATION_CHECK_ID

# --- Per-component dead-man's switches (Task 7.1) ---

# Each long-running component pings its OWN external monitor URL, provider-neutral (any
# service exposing a per-check ping URL works — Healthchecks.io, Better Uptime, ...). A
# shared URL is forbidden: it would stay green while one cron is dead. Leave unset locally to
# skip the ping; the worker and crons REQUIRE their own URL in staging & production or boot
# fails with CONFIG_MISSING_OR_INVALID naming the missing variable.
# (RECONCILIATION_CHECK_URL is the reconciliation cron's own check, in the section above.)
WORKER_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_WORKER_CHECK_ID
RETENTION_CHECK_URL=https://checks.example.com/ping/REPLACE_WITH_RETENTION_CHECK_ID

# How often (ms) the worker pings its liveness check while healthy. Keep it shorter than the
# external monitor's grace period so a single missed beat does not false-alarm.
WORKER_HEARTBEAT_INTERVAL_MS=60000

# Per-request timeout (ms) for the heartbeat HTTP GET. Fail fast rather than hang a beat.
HEARTBEAT_PING_TIMEOUT_MS=5000

# --- Classify stage / model spend (Task 5.1) ---

# Anthropic API key. Optional at boot, like DIALPAD_API_KEY — the Anthropic client
# construction validates presence, not boot. PLACEHOLDER ONLY — set a real per-environment
# key via the environment, never commit it.
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# Model ID for the classify stage. Never hardcoded outside config.
CLASSIFY_MODEL_ID=claude-haiku-4-5-20251001

# Kill switch: true | false. While false, the classify stage makes no Anthropic calls.
CLASSIFY_ENABLED=false

# Max output tokens requested per classify call.
CLASSIFY_MAX_TOKENS=512

# Cost-reservation floor (input tokens): the classify handler reserves against
# max(this ceiling, payload byte-estimate).
CLASSIFY_INPUT_TOKENS_CEILING=30000

# Fixed structured-output/request-scaffolding overhead (tokens) added to the byte-bound
# payload estimate when reserving against the daily cost cap.
CLASSIFY_RESERVATION_OVERHEAD_TOKENS=1000

# Anthropic TS SDK request timeout (ms).
ANTHROPIC_TIMEOUT_MS=30000

# Daily hard cap (USD) on model spend, enforced across ALL model stages.
DAILY_MODEL_COST_CAP_USD=25

# Haiku 4.5 list price per million input/output tokens (USD). Classify-scoped on purpose —
# Task 5.2 adds its own EXTRACT_* rates for Sonnet; the shared cost helper takes explicit
# rates with no defaults so a different model can never silently inherit Haiku pricing.
CLASSIFY_COST_USD_PER_MTOK_INPUT=1
CLASSIFY_COST_USD_PER_MTOK_OUTPUT=5

# --- Redaction stage (Task 4.1) ---

# Risk score at or above which a call is held with redaction_failed. Forced-hold
# reasons (offset alignment failure, residual scan hit) hold regardless of this value.
REDACTION_RISK_THRESHOLD=0.7

# Labeled-corpus recall the CI gate enforces (fails as REDACTION_RECALL_REGRESSION below it).
REDACTION_RECALL_TARGET=0.95

# Optional path to a newline-delimited client deny-list file (terms that must never pass).
# The file lives OUTSIDE the repo. Absent => empty deny list.
# REDACTION_DENY_LIST_PATH=/etc/call-insights/deny-list.txt

# transformers.js NER model id and the local directory it is vendored into by
# `npm run model:fetch`. Runtime is fully offline (allowRemoteModels=false).
REDACTION_NER_MODEL_ID=Xenova/bert-base-NER
REDACTION_NER_MODEL_DIR=models

# NER spans below this confidence are STILL redacted (fail closed) but raise the
# ner_low_confidence risk reason.
REDACTION_NER_MIN_SCORE=0.5

# Long-transcript chunking: chunk size and overlap (chars). Overlap keeps entities that
# span a chunk boundary visible whole in at least one chunk.
REDACTION_NER_CHUNK_CHARS=1500
REDACTION_NER_CHUNK_OVERLAP_CHARS=250

# Base64 key (>= 32 bytes decoded) for the per-call HMAC over normalized detected values
# in redaction_findings.value_hash. Optional at boot; the worker and the redaction handler
# fail fast with CONFIG_MISSING_OR_INVALID naming this variable if absent. PLACEHOLDER
# ONLY — set a real per-environment key via the environment, never commit it.
REDACTION_VALUE_HASH_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
